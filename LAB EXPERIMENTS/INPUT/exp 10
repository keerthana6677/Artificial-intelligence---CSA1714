
import heapq

graph = {
    'A': [('B', 1), ('C', 4)],
    'B': [('D', 2)],
    'C': [('D', 1)],
    'D': []
}

h = {'A': 3, 'B': 2, 'C': 1, 'D': 0}

def astar(start, goal):
    queue = [(h[start], 0, start, [start])]
    best = {start: 0}

    while queue:
        f, g, node, path = heapq.heappop(queue)

        if g > best[node]:
            continue

        if node == goal:
            print("Path:", path)
            print("Cost:", g)
            return

        for neighbor, cost in graph[node]:
            new_g = g + cost

            if new_g < best.get(neighbor, float('inf')):
                best[neighbor] = new_g
                heapq.heappush(queue,
                    (new_g + h[neighbor], new_g,
                     neighbor, path + [neighbor]))

astar('A', 'D')
